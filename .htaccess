# ----------------------------------------------------------------------
# Tokobii Production Root .htaccess (cPanel / Shared Hosting)
# ----------------------------------------------------------------------

<IfModule mod_negotiation.c>
    Options -MultiViews -Indexes
</IfModule>

# ----------------------------------------------------------------------
# 1. MIME TYPES (Model Biometrik & WebAssembly)
# ----------------------------------------------------------------------
<IfModule mod_mime.c>
    AddType application/json .json
    AddType application/octet-stream .bin
    AddType application/wasm .wasm
    <FilesMatch "shard[0-9]+$">
        ForceType application/octet-stream
    </FilesMatch>
</IfModule>

# ----------------------------------------------------------------------
# 2. CACHE & SECURITY HEADERS (Permissions-Policy & Immutable Cache)
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType application/json "access plus 1 month"
    ExpiresByType application/octet-stream "access plus 1 year"
    ExpiresByType application/wasm "access plus 1 year"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(bin|wasm|json)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>
    <FilesMatch "\.(css|js|woff2?|ttf|eot|svg|png|jpe?g|gif|webp|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    Header always set Permissions-Policy "camera=(self)"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/wasm
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/xml application/xhtml+xml application/javascript
</IfModule>

# ----------------------------------------------------------------------
# 3. BLOKIR FILE SENSITIF (Apache 2.4 & 2.2 Compliant)
# ----------------------------------------------------------------------
<FilesMatch "^(\.env.*|\.git.*|\.user\.ini|\.htaccess|\.gitignore|\.gitattributes|composer\.(json|lock|phar)|artisan|package(-lock)?\.json|phpunit\.xml|error_log|.*\.log|vite\.config\.js|tailwind\.config\.js|webpack\.mix\.js)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# ----------------------------------------------------------------------
# 4. REWRITE ENGINE & DIREKTORI SENSITIF BLOKIR
# ----------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Blokir direktori internal Laravel dari akses HTTP langsung
    # PERHATIAN: Rule ini HANYA memblokir /storage/..., /vendor/..., /app/..., dll.
    # Rule ini TIDAK memblokir /public/storage, /public/build, /public/models
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor)(/.*)?$ - [F,L,NC]

    # Blokir dotfiles & dotfolders (kecuali .well-known untuk validasi sertifikat SSL Let's Encrypt)
    RewriteRule (^|/)\.(?!well-known) - [F,L]

    # Handle Authorization Header untuk API / Auth Bearer
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Redirect Trailing Slashes Jika Bukan Direktori Fisik
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Routing ke Front Controller jika request bukan file atau direktori fisik
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
